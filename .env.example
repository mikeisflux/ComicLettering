# LetterMyComic — environment template. Copy to `.env` and fill in.
# The deploy script (scripts/deploy.sh) provisions PostgreSQL and writes
# DATABASE_URL here automatically on the server; you only need to edit this
# by hand for local development.

# PostgreSQL connection string.
DATABASE_URL="postgresql://comiclettering:CHANGE_ME@localhost:5432/comiclettering"

# Optional: seed a known superuser password (otherwise one is generated
# and printed once during seeding).
# SEED_ADMIN_PASSWORD="change-me"

# Most runtime secrets (SendGrid, PayPal, reCAPTCHA keys) are managed in the
# /admin console and stored in the database, so they do not belong here.

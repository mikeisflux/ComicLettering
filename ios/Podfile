platform :ios, '15.0'

target 'pwa-shell' do
  use_frameworks!
  # No pods: push notifications are stripped from this wrapper (the studio
  # doesn't use them) so the Firebase dependency is gone. `pod install`
  # still generates the workspace the Xcode scheme expects.
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
    end
  end
end

// LetterMyComic — SQL schema (Prisma ORM).
// Runs on PostgreSQL. Set DATABASE_URL in .env, e.g.
//   DATABASE_URL="postgresql://user:pass@localhost:5432/comiclettering"

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  isAdmin      Boolean   @default(false)
  subStatus    String    @default("none") // none | active | cancelled | suspended
  subPlan      String?   // monthly | yearly
  subId        String?   // PayPal subscription id
  subUpdatedAt DateTime? // event time of the last applied subscription-status write (webhook ordering guard)
  resetToken   String?   // sha256 of the password-reset token
  resetExpiry  DateTime? // when the reset token expires
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  projects     Project[]
  assets       UserAsset[]
  shares       ProjectShare[] @relation("memberShares")
  comments     PageComment[]  @relation("commentAuthor")
}

// Per-account custom assets: imported fonts and stamps.
model UserAsset {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String   // font | stamp
  name      String
  data      String   // data URL
  createdAt DateTime @default(now())

  @@index([userId, kind])
}

model Project {
  id        String   @id @default(cuid())
  name      String
  data      String   // full document JSON (pages, elements, embedded images)
  thumbnail String?  // small JPEG data-URL preview of page 1
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  shares    ProjectShare[]
  comments  PageComment[]
  reviews   ReviewPass[]

  @@index([userId])
}

// Collaboration: a book shared with another account.
//   letterer — full editing access (save over the book)
//   editor   — review access: read, comment, approve/request changes
model ProjectShare {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("memberShares", fields: [userId], references: [id], onDelete: Cascade)
  role      String   // letterer | editor
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
  @@index([userId])
}

// A note pinned to a point on a page — the review conversation.
model PageComment {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("commentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  pageIndex Int
  x         Float    // page coords
  y         Float
  body      String
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([projectId, pageIndex])
}

// Letterer/editor review passes: the letterer requests a pass, the editor
// closes it as approved or with changes requested.
model ReviewPass {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requestedBy String    // user id
  status      String    @default("open") // open | approved | changes
  note        String?
  closedBy    String?   // user id
  createdAt   DateTime  @default(now())
  closedAt    DateTime?

  @@index([projectId, status])
}

// Admin-managed configuration (API keys etc.) — overrides .env values.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// BotBlock firewall: IPs to drop at the Linux firewall (iptables) via the
// botblock-watcher/botblock-sync scripts. The app writes rows here (and to
// /tmp/botblock-pending) when it detects abuse.
model BlockedIP {
  id             String   @id @default(cuid())
  ipAddress      String   @unique
  reason         String
  violationCount Int      @default(1)
  blockedAt      DateTime @default(now())
  expiresAt      DateTime
  lastUserAgent  String?
  lastPath       String?
  lastActionId   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([ipAddress])
  @@index([expiresAt])
}

// Audit log of suspicious activity, used to tune thresholds and to escalate
// repeat offenders into BlockedIP.
model SuspiciousActivity {
  id        String   @id @default(cuid())
  ipAddress String
  reason    String
  actionId  String?
  path      String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([ipAddress])
  @@index([createdAt])
}

// Internal messaging: contact-form submissions, inbound site email
// (SendGrid Inbound Parse) and outbound replies sent via SendGrid.
model Message {
  id        String   @id @default(cuid())
  direction String   // in | out
  channel   String   // contact | email | reply
  fromEmail String
  fromName  String?
  toEmail   String?
  subject   String
  body      String
  read      Boolean  @default(false)
  threadId  String?  // id of the message this replies to
  createdAt DateTime @default(now())

  @@index([direction, read])
}

// LetterMyComic — SQL schema (Prisma ORM).
// Default provider is SQLite for zero-config local use; switch to
// "postgresql" (and DATABASE_URL in .env) for a hosted SQL database.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  isAdmin      Boolean   @default(false)
  subStatus    String    @default("none") // none | active | cancelled | suspended
  subPlan      String?   // monthly | yearly
  subId        String?   // PayPal subscription id
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  projects     Project[]
  assets       UserAsset[]
}

// Per-account custom assets: imported fonts and stamps.
model UserAsset {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String   // font | stamp
  name      String
  data      String   // data URL
  createdAt DateTime @default(now())

  @@index([userId, kind])
}

model Project {
  id        String   @id @default(cuid())
  name      String
  data      String   // full document JSON (pages, elements, embedded images)
  thumbnail String?  // small JPEG data-URL preview of page 1
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// Admin-managed configuration (API keys etc.) — overrides .env values.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Internal messaging: contact-form submissions, inbound site email
// (SendGrid Inbound Parse) and outbound replies sent via SendGrid.
model Message {
  id        String   @id @default(cuid())
  direction String   // in | out
  channel   String   // contact | email | reply
  fromEmail String
  fromName  String?
  toEmail   String?
  subject   String
  body      String
  read      Boolean  @default(false)
  threadId  String?  // id of the message this replies to
  createdAt DateTime @default(now())

  @@index([direction, read])
}
